# Copiar a .env y completar antes de correr el backend.

# Cadena de conexión a PostgreSQL (local, o el proveedor gestionado que elijan).
DATABASE_URL="postgresql://usuario:password@localhost:5432/ponedoras?schema=public"

# Secreto para firmar los JWT — generar uno largo y aleatorio, nunca el de este ejemplo.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Duración del access token.
JWT_EXPIRES_IN="8h"

PORT=4000

# Origen permitido para CORS (el dominio del frontend en producción).
CORS_ORIGIN="http://localhost:5173"
